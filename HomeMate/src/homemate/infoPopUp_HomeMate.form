            <Container class="javax.swing.JScrollPane" name="jScrollPane1">

              <Layout class="org.netbeans.modules.form.compat2.layouts.support.JScrollPaneSupportLayout"/>
              <SubComponents>
                <Component class="javax.swing.JTextArea" name="jTextArea1">
                  <Properties>
                    <Property name="editable" type="boolean" value="false"/>
                    <Property name="background" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="ff" green="ff" red="ff" type="rgb"/>
                    </Property>
                    <Property name="columns" type="int" value="20"/>
                    <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
                      <Font name="Arial" size="14" style="0"/>
                    </Property>
                    <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
                      <Color blue="0" green="0" red="0" type="rgb"/>
                    </Property>
                    <Property name="lineWrap" type="boolean" value="true"/>
                    <Property name="rows" type="int" value="5"/>
                    <Property name="text" type="java.lang.String" value="SELAMAT DATANG DI HOMEMATE!&#xa;Rumah Anda, Tanggung Jawab Anda.&#xa;&#xa;TENTANG APLIKASI INI&#xa;HomeMate merupakan aplikasi manajemen rumah tangga yang dirancang untuk membantu pengguna mengatur dan mengelola berbagai aktivitas sehari-hari di rumah secara lebih terstruktur, efisien, dan praktis.&#xa;&#xa;TUJUAN APLIKASI&#xa;Aplikasi ini bertujuan untuk mempermudah pengelolaan rumah tangga melalui satu platform terpadu yang menyediakan berbagai fitur untuk mengatur aktivitas harian, mengelola anggota keluarga, memantau persediaan kebutuhan rumah, serta mencatat pemasukan dan pengeluaran rumah tangga.&#xa;&#xa;FITUR UTAMA&#xa;1. Manajemen Anggota Rumah Tangga&#xa;&#xa;Mengelola informasi anggota rumah tangga serta pembagian tanggung jawab masing-masing anggota.&#xa;&#xa;2. Manajemen Aktivitas Rumah Tangga&#xa;&#xa;Membuat jadwal kegiatan, membagikan tugas kepada anggota, menentukan tingkat prioritas, serta memantau penyelesaian setiap pekerjaan rumah.&#xa;&#xa;3. Manajemen Persediaan Barang&#xa;&#xa;Memantau ketersediaan kebutuhan rumah tangga, mencatat jumlah persediaan, serta mengelola daftar barang yang perlu dibeli.&#xa;&#xa;4. Manajemen Keuangan&#xa;&#xa;Mencatat pemasukan dan pengeluaran rumah tangga serta memantau penggunaan anggaran untuk memenuhi kebutuhan sehari-hari.&#xa;&#xa;5. Dasbor dan Laporan&#xa;&#xa;Menampilkan ringkasan aktivitas rumah tangga, informasi persediaan barang, serta laporan pengelolaan rumah secara keseluruhan.&#xa;&#xa;PENGEMBANGAN APLIKASI&#xa;HomeMate dikembangkan menggunakan bahasa pemrograman Java dengan menerapkan konsep Pemrograman Berorientasi Objek (PBO).&#xa;&#xa;Aplikasi ini dirancang sebagai bentuk penerapan konsep pemrograman berorientasi objek dalam kehidupan sehari-hari, dengan merepresentasikan berbagai aktivitas dan kebutuhan rumah tangga ke dalam objek-objek yang saling berinteraksi untuk membentuk suatu sistem pengelolaan rumah tangga yang terintegrasi."/>
                    <Property name="wrapStyleWord" type="boolean" value="true"/>
                  </Properties>
                </Component>
              </SubComponents>
